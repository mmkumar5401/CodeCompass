{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Bash|bash)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-${OPENCODE_PROJECT_DIR:-.}}/.agents/hooks/block-file-search.py\""
          }
        ]
      },
      {
        "matcher": "^(Grep|grep)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-${OPENCODE_PROJECT_DIR:-.}}/.agents/hooks/block-file-search.py\""
          }
        ]
      },
      {
        "matcher": "^(Glob|glob)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-${OPENCODE_PROJECT_DIR:-.}}/.agents/hooks/block-file-search.py\""
          }
        ]
      }
    ]
  }
}
